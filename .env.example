# ==============================================================================
# YAYIN PLANLAMA SİSTEMİ - ORTAM DEĞİŞKENLERİ ŞABLONU (.env.example)
# ==============================================================================
# ÖNEMLİ GÜVENLİK NOTU:
# Bu dosya yalnızca örnek şablondur; gerçek IP adresi, ağ yolu veya şifre İÇERMEZ.
# Sunucuda kurulum yaparken bu dosyayı `.env` olarak kopyalayın (cp .env.example .env)
# ve aşağıdaki alanlara kendi sunucu bilgilerinizi girin.
# `.env` dosyası .gitignore içindedir ve Git deposuna ASLA gönderilmez.
# ==============================================================================

# 1. ANA UYGULAMA VE YEDEK SUNUCU TANIMLARI
APP_SERVER_HOST=127.0.0.1
APP_SERVER_HOSTNAME=app-server
APP_SERVER_USER=appuser
BACKUP_SERVER_HOST=127.0.0.1
BACKUP_SERVER_HOSTNAME=backup-server
BACKUP_SERVER_USER=backupuser
PORT=3001
FRONTEND_PORT=5173
SERVE_STATIC=true

# 2. GÜVENLİK ANAHTARI & VARSAYILAN YÖNETİCİ ŞİFRESİ
AUTH_TOKEN_SECRET=CHANGE_ME_ENTERPRISE_RANDOM_SECRET_KEY
ADMIN_INITIAL_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# 3. POSTGRESQL VERİTABANI SUNUCUSU
PG_HOST=127.0.0.1
PG_HOSTNAME=db-server
PG_SERVER_USER=dbuser
PG_PORT=5432
PG_DATABASE=yayin_planlama
PG_USER=postgres
PG_PASSWORD=CHANGE_ME_PG_PASSWORD

# 4. UZAK MAM VERİTABANI (Microsoft SQL Server)
MSSQL_HOST=127.0.0.1
MSSQL_PORT=1433
MSSQL_DATABASE=CHANGE_ME_MAM_DB
MSSQL_USER=CHANGE_ME_MAM_USER
MSSQL_PASSWORD=CHANGE_ME_MSSQL_PASSWORD
MSSQL_CONNECT_TIMEOUT=5000
MSSQL_REQUEST_TIMEOUT=60000

# 5. MEDYA VE VİDEO ARŞİV SUNUCUSU (SMB / CIFS AĞ PAYLAŞIM YOLLARI)
MAM_SMB_HOST=127.0.0.1
MAM_SMB_DOMAIN=WORKGROUP
MAM_SMB_USER=CHANGE_ME_SMB_USER
MAM_SMB_PASSWORD=CHANGE_ME_SMB_PASSWORD
MAM_SMB_SHARE_HIGHRES=media_highres
MAM_SMB_SHARE_ARCHIVE=media_archive
MAM_HIGHRES_PATH=/mnt/media_highres
YAYIN_ARSIV_PATH=/mnt/media_archive

# 6. PYTHON & FRONTEND PROXY HEDEFLERİ
PYTHON_BIN=python3
VITE_API_TARGET=http://127.0.0.1:3001
