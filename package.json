{
  "name": "yayin-planlama-sistemi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"node --watch backend/server.js\"",
    "start": "node backend/server.js",
    "build": "vite build",
    "db:up": "docker compose -f docker-compose.db.yml up -d",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:migrate": "node backend/scripts/migrate_to_postgres.js",
    "app:docker:up": "docker compose -f docker-compose.app.yml up -d --build",
    "app:docker:down": "docker compose -f docker-compose.app.yml down",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "test:connections": "node deploy/test_80_app.js",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.110.8",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "date-fns": "^3.6.0",
    "express": "^5.2.1",
    "lucide-react": "^0.378.0",
    "mssql": "^12.7.0",
    "node-cache": "^5.1.2",
    "pg": "^8.23.1",
    "plyr": "^3.8.4",
    "plyr-react": "^6.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.18.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vite": "^5.2.0"
  }
}
